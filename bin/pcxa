#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if ! python3 -c 'import requests' >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pcxa requires Python package "requests".

Install the CLI once with:
  pipx install git+https://github.com/PCX-Analytics/pcxa-skill.git

Or install requests for your Python environment.
EOF
  exit 1
fi

exec python3 "$PLUGIN_ROOT/pcxa.py" "$@"
